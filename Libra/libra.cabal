cabal-version:      3.0
name:               libra
version:            0.1.0.0
synopsis:           4つのエネルギーの状態からゾーンを判定するCLI
license:            MIT
author:             RyosukeDTomita
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Libra
    hs-source-dirs:   src
    build-depends:    base >=4.21 && <5
    default-language: GHC2021

executable libra
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.21 && <5
                    , libra
    default-language: GHC2021

test-suite libra-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >=4.21 && <5
                    , libra
                    , hspec
    default-language: GHC2021
